---
import "../../styles/global.css";

export const prerender = false;

type EventoDetalle = {
  id: number;
  slug: string;
  nombre: string;
  fecha: string;
  hora: string;
  lugar: string;
  descripcion: string;
  precio?: number | string;
};

const { slug } = Astro.params;

if (!slug) {
  return new Response("Slug no válido", { status: 400 });
}

const eventoResponse = await fetch(
  `https://panel.festivalburijazz.com/api/eventos.php?slug=${encodeURIComponent(slug)}`,
  { cache: "no-store" }
);

if (!eventoResponse.ok) {
  return new Response("No se pudo cargar el evento", { status: 500 });
}

const eventoData = await eventoResponse.json();
const event: EventoDetalle | null = Array.isArray(eventoData)
  ? eventoData[0] ?? null
  : eventoData ?? null;

if (!event) {
  return new Response("Evento no encontrado", { status: 404 });
}

const eventTitle = event.nombre ?? "Evento";
const eventDescription = event.descripcion ?? "Sin descripción";
const eventDate = event.fecha ?? "Fecha por confirmar";
const eventTime = event.hora ?? "Hora por confirmar";
const eventVenue = event.lugar ?? "Lugar por confirmar";
const eventPrice = event.precio ?? 80;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{eventTitle} | Buri Jazz</title>
    <meta name="description" content={eventDescription} />
  </head>

  <body class="bg-[#121a4a] text-[#efe0a2]">
    <header class="border-b border-[#efe0a2]/10 bg-[#121a4a]">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
        <a
          href="/"
          class="text-lg font-black uppercase tracking-[0.35em] text-[#d4aa2a]"
        >
          Buri Jazz
        </a>
      </div>
    </header>

    <main class="px-6 py-16">
      <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.2fr_0.8fr]">
        <section>
          <p class="mb-4 text-xs uppercase tracking-[0.45em] text-[#efe0a2]/60">
            Evento
          </p>

          <h1 class="text-4xl font-black uppercase tracking-[-0.03em] text-[#d4aa2a] md:text-6xl">
            {eventTitle}
          </h1>

          <p class="mt-8 max-w-2xl text-base leading-8 text-[#efe0a2]/82">
            {eventDescription}
          </p>
        </section>

        <aside class="bg-[#b44a2b] p-8 shadow-[10px_10px_0_rgba(47,67,143,0.45)]">
          <p class="text-xs uppercase tracking-[0.35em] text-[#efe0a2]/70">Fecha</p>
          <p class="mt-2 text-2xl font-black text-[#efe0a2]">{eventDate}</p>

          <p class="mt-6 text-xs uppercase tracking-[0.35em] text-[#efe0a2]/70">Hora</p>
          <p class="mt-2 text-2xl font-black text-[#efe0a2]">{eventTime}</p>

          <p class="mt-6 text-xs uppercase tracking-[0.35em] text-[#efe0a2]/70">Lugar</p>
          <p class="mt-2 text-2xl font-black text-[#efe0a2]">{eventVenue}</p>

          <p class="mt-6 text-xs uppercase tracking-[0.35em] text-[#efe0a2]/70">Precio</p>
          <p class="mt-2 text-3xl font-black text-[#d4aa2a]">Bs {eventPrice}</p>

          <a
            href={`/asientos/${event.slug}`}
            class="mt-8 inline-flex bg-[#efe0a2] px-6 py-3 text-sm font-black uppercase tracking-[0.18em] text-[#121a4a] transition hover:translate-x-[2px] hover:translate-y-[2px]"
          >
            Elegir asientos
          </a>
        </aside>
      </div>
    </main>
  </body>
</html>